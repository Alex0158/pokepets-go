import { createServer } from 'node:http';
import { readFile } from 'node:fs/promises';
import { start, stop } from '../src/server/realtime/service.ts';
const html=`<!doctype html><html><body><h1>Realtime synthetic WebRTC smoke</h1><p>No microphone. A synthetic speech recording is used.</p><button id="start">Start synthetic session</button><button id="stop">Stop</button><pre id="state">idle</pre><script>
let pc,stream,id,ctx;const state=document.querySelector('#state');function show(s){state.textContent+=(state.textContent?' | ':'')+s;}
document.querySelector('#start').onclick=async()=>{try{state.textContent='';show('connecting');ctx=new AudioContext();const dst=ctx.createMediaStreamDestination(),osc=ctx.createOscillator(),quiet=ctx.createGain();quiet.gain.value=0.0001;osc.connect(quiet).connect(dst);osc.start();stream=dst.stream;pc=new RTCPeerConnection();pc.addTrack(stream.getAudioTracks()[0],stream);const ch=pc.createDataChannel('oai-events');ch.onopen=async()=>{show('data-channel-open');const wav=await fetch('/sample.wav').then(r=>r.arrayBuffer());const audio=await ctx.decodeAudioData(wav);show('synthetic-duration-'+audio.duration.toFixed(1));const source=ctx.createBufferSource();source.buffer=audio;source.connect(dst);source.onended=()=>show('synthetic-played');setTimeout(()=>source.start(),2000);};ch.onmessage=e=>{const v=JSON.parse(e.data);if(['session.created','session.updated','input_audio_buffer.speech_started','input_audio_buffer.speech_stopped','conversation.item.input_audio_transcription.completed','response.output_audio_transcript.done','response.done'].includes(v.type))show(v.type);if(v.type==='error')show('provider-error '+(v.error?.code||'unknown'));};const offer=await pc.createOffer();await pc.setLocalDescription(offer);const res=await fetch('/start',{method:'POST',headers:{'content-type':'application/json'},body:JSON.stringify({sdp:offer.sdp})});const value=await res.json();if(!res.ok){show('start-failed '+res.status+' '+value.error);return;}id=value.sessionId;await pc.setRemoteDescription({type:'answer',sdp:value.sdp});}catch(e){show('error '+e.name);}};
document.querySelector('#stop').onclick=async()=>{pc?.close();stream?.getTracks().forEach(t=>t.stop());await ctx?.close();if(id){const r=await fetch('/stop',{method:'POST',headers:{'content-type':'application/json'},body:JSON.stringify({sessionId:id})});show(r.ok?'stopped':'stop-failed '+r.status);}else show('stopped');};
</script></body></html>`;
const server=createServer(async(req,res)=>{try{
  if(req.method==='GET'&&req.url==='/'){res.writeHead(200,{'content-type':'text/html','cache-control':'no-store'});res.end(html);return;}
  if(req.method==='GET'&&req.url==='/sample.wav'){const sample=await readFile('/private/tmp/pokepet-synthetic-voice-20261101b.wav');res.writeHead(200,{'content-type':'audio/wav','cache-control':'no-store'});res.end(sample);return;}
  if(req.method!=='POST'||!['/start','/stop'].includes(req.url??'')||req.headers.origin!=='http://127.0.0.1:4211'){res.writeHead(403);res.end();return;}
  let raw='';for await(const chunk of req){raw+=chunk;if(raw.length>65536)throw Error('too_large');}const body=JSON.parse(raw);
  if(req.url==='/start'){const result=await start('synthetic-smoke',body.sdp);res.writeHead(200,{'content-type':'application/json'});res.end(JSON.stringify(result));return;}
  await stop('synthetic-smoke',body.sessionId);res.writeHead(200,{'content-type':'application/json'});res.end(JSON.stringify({stopped:true}));
}catch(error){const code=error instanceof Error&&/^(?:realtime_http_\d{3}|realtime_location_missing|invalid_sdp_answer|provider_unavailable)$/.test(error.message)?error.message:'realtime_error';res.writeHead(503,{'content-type':'application/json'});res.end(JSON.stringify({error:code}));}});
server.listen(4211,'127.0.0.1',()=>console.log('Synthetic WebRTC smoke ready on localhost:4211'));
